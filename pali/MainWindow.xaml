<Window x:Class="pali.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pali"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Background="CornflowerBlue">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Label Foreground="White" Content="Palacsinta rendelés" Grid.ColumnSpan="2" FontSize="30" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
        <TextBox Grid.Row="1" FontSize="25" Margin="20 15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Name="Quantity" Text="Palacsinta darabszám:" Tag="Palacsinta darabszám:"></TextBox>
        <TextBox Grid.Row="2" FontSize="25" Margin="20 15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Name="Type" Text="Tészat tipusa:" Tag="Tészat tipusa:"></TextBox>
        <TextBox Grid.Row="3" FontSize="25" Margin="20 15" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Name="FillingType" Text="Töltelék tipusa:" Tag="Töltelék tipusa:"></TextBox>
        <StackPanel Name="Pancake" Margin="20 10" Grid.Row="1" Grid.Column="1" Grid.RowSpan="4" ></StackPanel>
        <Button Name="Plus" Content="Hozzáadás" FontSize="25" Margin="50 10" Grid.Row="4"></Button>
        <Button Name="Cancel" Content="Mégse" FontSize="25" Margin="50 10" Grid.Row="5"></Button>
        <Button Name="Order" Tag="Rendelés" Content="Rendelés" FontSize="25" Margin="50 10" Grid.Row="5" Grid.Column="1"></Button>
    </Grid>
</Window>
